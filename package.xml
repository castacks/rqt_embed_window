<?xml version="1.0" encoding="UTF-8"?>
<package format="3">
  <name>rqt_embed_window</name>
  <version>0.9.0</version>
  <description>rqt_embed_window provides a GUI plugin to embed other windows</description>

  <maintainer email="sammypfeiffer@gmail.com">Sammy Pfeiffer</maintainer>
  <license>BSD</license>
  <author email="sammypfeiffer@gmail.com">Sammy Pfeiffer</author>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>rqt_gui</depend>
  <depend>rqt_gui_py</depend>
  <depend>python3-qt5</depend>
  <depend>wmctrl</depend>

  <export>
    <build_type>ament_python</build_type>
    <rqt_gui plugin="${prefix}/plugin.xml"/>
  </export>
</package>